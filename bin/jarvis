#!/bin/bash
#
# One command for everything. Starts the brain and the face in the background
# (no terminal to keep open, no `npm start`), then opens JARVIS in a new
# full-size window of your normal Chrome. Click INITIALISE to wake him.
#
#   jarvis          start if needed, then open his window
#   jarvis stop     shut him down
#   jarvis logs     follow the log
#
# Settings come from the environment, with defaults below. The ElevenLabs key
# is read from the macOS Keychain (service "elevenlabs") so it never sits in a
# file:  security add-generic-password -a "$USER" -s elevenlabs -w

DIR="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$HOME/Library/Logs/jarvis.log"
PIDFILE="$DIR/.jarvis.pid"
URL="http://localhost:5173/"

# launchd (the clap listener) starts us with a bare PATH.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"

ready() {
  curl -s http://localhost:8788/health | grep -q '"ok":true' &&
    curl -s -o /dev/null http://localhost:5173
}

start_servers() {
  if [ -z "${ELEVENLABS_API_KEY:-}" ]; then
    ELEVENLABS_API_KEY="$(security find-generic-password -a "$USER" -s elevenlabs -w 2>/dev/null)"
    export ELEVENLABS_API_KEY
  fi
  export JARVIS_VOICE_ID="${JARVIS_VOICE_ID:-0b0iqagmTWiLn7v15IEs}"
  export JARVIS_MODEL="${JARVIS_MODEL:-claude-sonnet-5-5}"
  export JARVIS_EFFORT="${JARVIS_EFFORT:-low}"

  echo "Starting JARVIS..."
  mkdir -p "$(dirname "$LOG")"
  cd "$DIR" || exit 1
  nohup node scripts/start.mjs >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"

  for _ in $(seq 60); do
    ready && return 0
    sleep 1
  done
  echo "JARVIS didn't start within 60 seconds. Last lines of $LOG:"
  tail -n 20 "$LOG"
  return 1
}

open_window() {
  # Your normal Chrome, not a separate profile: that is where the microphone
  # works. A new window, sized to fill the screen without going fullscreen.
  # If Chrome wasn't running, use the window it opens on launch instead of
  # adding a second one.
  osascript - "$URL" <<'OSA'
on run argv
  set wasRunning to application "Google Chrome" is running
  tell application "Finder" to set b to bounds of window of desktop
  tell application "Google Chrome"
    activate
    if not wasRunning then
      repeat 20 times
        if (count of windows) > 0 then exit repeat
        delay 0.2
      end repeat
    end if
    if wasRunning or (count of windows) is 0 then
      set w to make new window
    else
      set w to window 1
    end if
    set URL of active tab of w to item 1 of argv
    set bounds of w to {0, 0, item 3 of b, item 4 of b}
  end tell
end run
OSA
}

stop_all() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  echo "JARVIS stopped."
}

case "${1:-}" in
  stop) stop_all ;;
  logs) tail -n 50 -f "$LOG" ;;
  "")
    ready || start_servers || exit 1
    open_window
    ;;
  *)
    echo "usage: jarvis [stop|logs]"
    exit 1
    ;;
esac
