#!/bin/bash
# Claude Code status line → JARVIS, then whatever status line you had before.
#
# The JSON goes to the local bridge in the background (it never delays the
# status line). Your previous status line command, if you had one, was saved
# to ~/.jarvis/statusline-chain by `jarvis setup-claude` and still prints.
input="$(cat)"
TOKEN="$(cat "$HOME/.jarvis/token" 2>/dev/null)"
if [ -n "$TOKEN" ]; then
  (printf '%s' "$input" | curl -s -m 1 -X POST "http://127.0.0.1:${JARVIS_BRIDGE_PORT:-8788}/api/statusline" \
    -H "authorization: Bearer $TOKEN" -H 'content-type: application/json' \
    --data-binary @- >/dev/null 2>&1 &)
fi
CHAIN="$HOME/.jarvis/statusline-chain"
if [ -s "$CHAIN" ]; then
  printf '%s' "$input" | bash -c "$(cat "$CHAIN")"
else
  printf '%s' "$input" | node -e '
    let s = ""; process.stdin.on("data", (c) => (s += c)).on("end", () => {
      try {
        const j = JSON.parse(s)
        const parts = [j.model?.display_name]
        if (j.context_window?.used_percentage != null) parts.push(`context ${Math.round(j.context_window.used_percentage)}%`)
        const f = j.rate_limits?.five_hour
        if (f?.used_percentage != null) parts.push(`5h ${Math.round(f.used_percentage)}% used`)
        process.stdout.write(parts.filter(Boolean).join(" · "))
      } catch { process.stdout.write("") }
    })'
fi
